# TrendRadar Docker environment example for local/CI-safe validation.
# Copy to docker/.env only for local non-secret development.
# Do not commit real tokens, passwords, webhooks, or S3 credentials.

# Web server
WEBSERVER_PORT=8080

# Notifications: disabled/empty by default
FEISHU_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DINGTALK_WEBHOOK_URL=
WEWORK_WEBHOOK_URL=
WEWORK_MSG_TYPE=markdown
EMAIL_FROM=
EMAIL_PASSWORD=
EMAIL_TO=
EMAIL_SMTP_SERVER=
EMAIL_SMTP_PORT=
NTFY_SERVER_URL=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=
BARK_URL=
SLACK_WEBHOOK_URL=
GENERIC_WEBHOOK_URL=
GENERIC_WEBHOOK_TEMPLATE=

# AI: disabled in CI/control-plane validation
AI_ANALYSIS_ENABLED=false
AI_API_KEY=
AI_MODEL=
AI_API_BASE=

# Remote storage: disabled/empty by default
S3_ENDPOINT_URL=
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=

# Non-production run mode defaults
CRON_SCHEDULE=*/30 * * * *
RUN_MODE=once
IMMEDIATE_RUN=false
